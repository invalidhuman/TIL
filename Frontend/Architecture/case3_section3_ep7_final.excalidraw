    {
      "id": "dNbkvExPlNj3p0y9XFfOf",
      "type": "text",
      "x": 15825.495040072072,
      "y": -2321.009497099496,
      "width": 1295.315673828125,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2U",
      "roundness": null,
      "seed": 347800041,
      "version": 551,
      "versionNonce": 2129612297,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784662271913,
      "link": null,
      "locked": false,
      "text": "interface FeedStore {\n    posts: Record<PostId, Post> \n\n    feeds: {\n            home: { ids: PostId []; cursor: string | null; staleAt: number };\n            profile: Record<UserId, { ids: PostId[]; cursor: string | null} >; \n    };\n\n} \n\nfunction mergePage(store: FeedStore , page: FeedPage) {\n    for (const post of page.posts) {\n        store.posts[post.id] = { ...store.posts[post.id], ...post } ;\n    } \n\n     store.feeds.home.ids.push(...page.posts.map ( p => p.id));\n     store.feeds.home.cursor = page.pageInfo.endCursor;\n} \n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface FeedStore {\n    posts: Record<PostId, Post> \n\n    feeds: {\n            home: { ids: PostId []; cursor: string | null; staleAt: number };\n            profile: Record<UserId, { ids: PostId[]; cursor: string | null} >; \n    };\n\n} \n\nfunction mergePage(store: FeedStore , page: FeedPage) {\n    for (const post of page.posts) {\n        store.posts[post.id] = { ...store.posts[post.id], ...post } ;\n    } \n\n     store.feeds.home.ids.push(...page.posts.map ( p => p.id));\n     store.feeds.home.cursor = page.pageInfo.endCursor;\n} \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HCkE6A4v-vTMhyz3Rg2xG",
      "type": "text",
      "x": 13951.828177307212,
      "y": -2178.946758378673,
