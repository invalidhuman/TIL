      "link": null,
      "locked": false,
      "text": "pre-fetch \n\n센티넬 방식 적용 \n\nuseEffect(()=> {\n    if (inView && hasNextPage) fetchNextPage();\n}, [inView, hasNextPage]);\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pre-fetch \n\n센티넬 방식 적용 \n\nuseEffect(()=> {\n    if (inView && hasNextPage) fetchNextPage();\n}, [inView, hasNextPage]);\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
