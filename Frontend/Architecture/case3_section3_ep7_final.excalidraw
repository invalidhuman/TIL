      "boundElements": [],
      "updated": 1784663181290,
      "link": null,
      "locked": false,
      "text": "counts: { likes: 5, reposts: 2} \n클라이언트 규칙 +-1 => 서버응답 도착시 무조건 교체 \n\nviewer state : { liked : true } \n데이터의 소유권은 클라이언트 \n클라이언트 - 탭 즉시 반전 \n(낙관적 확신) \n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "counts: { likes: 5, reposts: 2} \n클라이언트 규칙 +-1 => 서버응답 도착시 무조건 교체 \n\nviewer state : { liked : true } \n데이터의 소유권은 클라이언트 \n클라이언트 - 탭 즉시 반전 \n(낙관적 확신) \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WufKuJbdlrpFUtGTtEbJC",
      "type": "text",
      "x": 12401.939326858901,
      "y": -1892.0338414679659,
      "width": 860.3277587890625,
      "height": 405,
      "angle": 0,
