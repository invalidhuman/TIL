      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "setLikes(likes + 1);\nconst res = await api.like(id);\nsetLikes(res.likes);\n\n",
      "autoResize": true,
