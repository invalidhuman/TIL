    {
      "id": "DIKKCgvROLlpNnO6FaS6o",
      "type": "text",
      "x": 17434.524057119612,
      "y": -4522.042318975397,
      "width": 1222.73974609375,
      "height": 1395,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b32",
      "roundness": null,
      "seed": 2025293294,
      "version": 911,
      "versionNonce": 1012378162,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784832741203,
      "link": null,
      "locked": false,
      "text": "const lastOpId = new Map<PostId, number>();\nlet opSeq = 0;\n\nasync function toggleLike(store: FeedStore, id: PostId) {\n    const post = store.posts[id];\n    const myOp = ++opSeq;\n    \n    lastOpId.set(id, myOp);\n    \n    const liked = !post.viewerState.liked;\n    post.viwerState.liked = liked;\n    post.counts.likes += liked ? 1: -1;\n\n    try {\n        const server = await api.setLike(id, liked);\n        \n        if(lastOpId.get(id) !== myOp) return;\n        \n        post.counts = server.counts;\n        post.viewerState = server.viewerState;\n    } catch {\n        if (lastOpId.get(id) !== myOp) return;\n        post.viewerState.liked = !liked;\n        post.counts.likes += liked ? -1: 1;\n        metrics.increment(\"optimistic_rollback\");\n        toast.error(\"좋아요에 실패\", {\n            action: { label: \"재시도\", onClick: () => toggleLike(store, id) },\n        });\n    }\n} \n    ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const lastOpId = new Map<PostId, number>();\nlet opSeq = 0;\n\nasync function toggleLike(store: FeedStore, id: PostId) {\n    const post = store.posts[id];\n    const myOp = ++opSeq;\n    \n    lastOpId.set(id, myOp);\n    \n    const liked = !post.viewerState.liked;\n    post.viwerState.liked = liked;\n    post.counts.likes += liked ? 1: -1;\n\n    try {\n        const server = await api.setLike(id, liked);\n        \n        if(lastOpId.get(id) !== myOp) return;\n        \n        post.counts = server.counts;\n        post.viewerState = server.viewerState;\n    } catch {\n        if (lastOpId.get(id) !== myOp) return;\n        post.viewerState.liked = !liked;\n        post.counts.likes += liked ? -1: 1;\n        metrics.increment(\"optimistic_rollback\");\n        toast.error(\"좋아요에 실패\", {\n            action: { label: \"재시도\", onClick: () => toggleLike(store, id) },\n        });\n    }\n} \n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
