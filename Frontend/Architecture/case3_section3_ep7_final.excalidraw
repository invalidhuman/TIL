      "text": "interface FeedPage {\n    posts: Post[];\n    pageInfo: {\n        endCursor: string | null;\n         hasNextPage: boolean;\n    };\n}\n\ninterface Media {\n    url: string;\n    width: number;\n    height: number;\n    blurhash?: string;\n }",
