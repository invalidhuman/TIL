			"type": "text",
			"x": 11781.26907844725,
			"y": 1071.9049013226893,
			"width": 1266.51611328125,
			"height": 360,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "cross-hatch",
			"strokeWidth": 2,
